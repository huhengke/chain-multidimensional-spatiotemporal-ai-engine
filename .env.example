# Required for cloud model channels. Leave empty when using only local models.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Authentication values must be replaced before a shared deployment.
ENGINE_SERVICE_TOKEN=replace-with-a-long-random-service-token
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Optional model-channel overrides. Uncomment only when an override is needed.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# CODEX_BASE_URL=https://your-internal-model-gateway.example
# CODEX_MODEL=your-model-name
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=deepseek-v4.1-flash

# Optional paths. Uncomment only when data or engine code is outside this repository.
# CHAIN_SOURCE_DATA_ROOT=D:\\controlled-data-source
# CHAIN_ENGINE_ROOT=D:\\chain-neuron-engine

# Optional local ports and topology threshold.
ENGINE_PORT=8000
AGENT_PORT=8001
GROWTH_THRESHOLD=10000
